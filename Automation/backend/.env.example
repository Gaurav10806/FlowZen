# ==============================================================================
# FLOWZEN PRODUCTION & DEVELOPMENT MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GENERAL & SITE CONFIGURATION
# ------------------------------------------------------------------------------
SITE_URL=http://localhost:8000
PORT=8000
WEB_CONCURRENCY=4

# ------------------------------------------------------------------------------
# 2. DJANGO CORE CONFIGURATION
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=your-secret-key
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000
CORS_ALLOW_ALL_ORIGINS=False

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL or DATABASE_URL)
# ------------------------------------------------------------------------------
# PaaS Database URL (Railway, Render, DigitalOcean):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=automation_db
DATABASE_USER=automation_user
DATABASE_PASSWORD=automation_pass
DJANGO_DB_SQLITE=False

# ------------------------------------------------------------------------------
# 4. REDIS CONFIGURATION
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 5. CELERY CONFIGURATION
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_ALWAYS_EAGER=False

# ------------------------------------------------------------------------------
# 6. AI PROVIDER CONFIGURATION (Pluggable: 'ollama' vs 'gemini')
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini  

# Google Gemini Settings (Used when AI_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Ollama Settings (Used when AI_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# OpenAI Settings (Optional fallback provider)
OPENAI_API_KEY=sk-your-openai-api-key
AI_MODEL=gpt-4
AI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 7. OAUTH INTEGRATIONS & REDIRECT URIS
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

GMAIL_OAUTH_CLIENT_ID=your-gmail-oauth-client-id
GMAIL_OAUTH_CLIENT_SECRET=your-gmail-oauth-client-secret
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/gmail-oauth/callback/

GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/google-calendar-oauth/callback/

# ------------------------------------------------------------------------------
# 8. EMAIL CONFIGURATION (SMTP & Gmail API)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@domain.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@flowzen.ai
EMAIL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 9. FILE STORAGE & MEDIA CONFIGURATION
# ------------------------------------------------------------------------------
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage

# ------------------------------------------------------------------------------
# 10. SECURITY & ENCRYPTION KEYS
# ------------------------------------------------------------------------------
CREDENTIALS_MASTER_KEY=IeOn9kTi1EaZWc2cgToDvqJq9PjrZe8oi-FOlhDwZaM=
FIELD_ENCRYPTION_KEY=your-field-encryption-key
WEBHOOK_SECRET_KEY=your-webhook-key

# ------------------------------------------------------------------------------
# 11. PAYMENT PROCESSING (Stripe)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 12. LOGGING, MONITORING & CAPACITY
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
DJANGO_LOG_LEVEL=INFO
SLOW_REQUEST_THRESHOLD=2.0
MAX_QUERIES_PER_REQUEST=50
GLOBAL_EXECUTION_CAPACITY=100
DEFAULT_TENANT_EXECUTION_CAPACITY=50
DEFAULT_WORKFLOW_EXECUTION_CAPACITY=10
RATE_TENANT_EXECUTION=30/min
RATE_TENANT_WEBHOOK=300/min
